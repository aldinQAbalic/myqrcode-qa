{
  "name": "myqrcode-qa",
  "version": "1.0.0",
  "description": "E2E automation for myqrcode.com (Playwright + TypeScript)",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:smoke": "playwright test --grep @smoke --project=unit --project=setup --project=chromium --project=chromium-auth --project=mobile",
    "test:regression": "playwright test --project=setup --project=chromium --project=chromium-auth --project=mobile",
    "test:headed": "playwright test --headed --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "auth:save": "playwright codegen --save-storage=.auth/user.json https://myqrcode.com/login",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^18.0.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
